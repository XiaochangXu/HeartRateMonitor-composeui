<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.DeviceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:HeartRate.Models"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="420">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="12,0,0,0">
            <TextBlock x:Uid="DeviceList_HeaderText"
                       Text="心率设备"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
                <ToggleButton x:Name="BtnScan"
                              Command="{x:Bind ViewModel.ToggleScanCommand}"
                              IsChecked="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ScanButtonContent, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="BtnClear"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Uid="DeviceList_Clear"
                                   Text="清除"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,8,0,0">
            <ListView x:Name="DevicesListView"
                      ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                      SelectionMode="Single"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BleDeviceInfo">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Vertical"
                                        Spacing="6"
                                        Margin="0,12,0,12">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Grid.Column="0"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Column="1"
                                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="8,0,0,0"
                                            Visibility="{x:Bind HasHeartRateService, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock x:Uid="DeviceList_HrBadge"
                                                   Text="● 心率"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock Text="{x:Bind AddressText, Mode=OneTime}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Visibility="{x:Bind ViewModel.EmptyHintVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        IsHitTestVisible="False">
                <FontIcon Glyph="&#xE9D9;"
                          FontSize="28"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="DeviceList_EmptyHint"
                           Text="未发现设备，请先开启扫描"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
