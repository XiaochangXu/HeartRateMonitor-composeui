    <string name="privacy_title">隐私政策</string>
    <string name="privacy_intro">本应用注重您的隐私保护。以下是应用可能访问的数据及其用途说明。所有数据均存储在本地设备，不会上传到任何服务器。</string>
    <string name="privacy_bluetooth_title">蓝牙设备信息</string>
    <string name="privacy_bluetooth_desc">访问蓝牙以扫描、连接心率监测设备。读取设备名称、MAC 地址（仅用于设备识别与自动重连），不收集设备厂商等其他信息。</string>
    <string name="privacy_heart_rate_title">心率数据</string>
    <string name="privacy_heart_rate_desc">实时读取心率值与 RR 间期，记录并保存到本地数据库，用于历史查看与统计分析。数据仅保存在本设备，不会上传。</string>
    <string name="privacy_location_title">位置信息</string>
    <string name="privacy_location_desc">为统计运动速度，可选择开启 GPS 记录位置数据。此功能默认关闭，需您手动授权并开启，数据仅保存在本地。</string>
    <string name="privacy_storage_title">本地存储</string>
    <string name="privacy_storage_desc">将心率历史记录、设置项等保存到本地数据库与文件，确保应用关闭后数据不丢失。</string>
    <string name="privacy_notification_title">通知权限</string>
    <string name="privacy_notification_desc">在心率超出预设阈值或设备断开时发送通知提醒，便于您及时关注健康状态。</string>
    <string name="privacy_network_title">网络访问</string>
    <string name="privacy_network_desc">用于检查应用更新、访问项目仓库；可选启用的 HTTP/WebSocket 服务器与 Webhook 推送功能也使用网络。不会上传您的个人数据。</string>
    <string name="privacy_foreground_service_title">前台服务</string>
    <string name="privacy_foreground_service_desc">使用前台服务在后台持续监测心率，保证屏幕关闭时数据记录不中断，并以通知形式显示运行状态。</string>
    <string name="privacy_clipboard_title">剪贴板</string>
    <string name="privacy_clipboard_desc">仅在您长按版本号时将版本号复制到剪贴板，不会自动读取或上传剪贴板内容。</string>
    <string name="privacy_conclusion_title">数据安全说明</string>
    <string name="privacy_conclusion_desc">本应用不收集、不上传、不分享任何可识别您个人身份的信息。所有数据均存储在本设备，卸载应用即彻底删除。</string>
