<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.VersionInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="VersionInfo_Header"
                   Grid.Row="0"
                   Text="版本与信息"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="20,0,0,12" />

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,12,0">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="20">
                <StackPanel Spacing="18">
                    <!-- 当前版本 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_CurrentVersionLabel"
                                   Text="当前版本"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText"
                                   Text="4.4"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- 检查更新 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_CheckUpdateLabel"
                                   Text="检查更新"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="CheckUpdateButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,6"
                                Click="OnCheckUpdateClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="14"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="CheckUpdateButtonText"
                                           x:Uid="VersionInfo_CheckUpdateButton"
                                           Text="检查更新"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Uid="VersionInfo_CheckUpdateHint"
                                   Text="从 Gitee 获取最新版本信息"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- 查看项目仓库 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_RepoLabel.Text"
                                   Text="查看项目仓库"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         NavigateUri="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         Padding="0" />
                    </StackPanel>

                    <!-- Android 端链接 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_AndroidLabel"
                                   Text="Android端链接"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         NavigateUri="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
