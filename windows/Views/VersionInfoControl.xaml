<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.VersionInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="VersionInfo_Header"
                   Grid.Row="0"
                   Text="版本与信息"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="20,0,0,12" />

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,12,0">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="20">
                <StackPanel Spacing="18">
                    <!-- 当前版本 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_CurrentVersionLabel"
                                   Text="当前版本"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText"
                                   Text="1.0.1"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- 查看项目仓库 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_RepoLabel"
                                   Text="查看项目仓库"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         NavigateUri="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         Padding="0" />
                    </StackPanel>

                    <!-- Android 端链接 -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="VersionInfo_AndroidLabel"
                                   Text="Android端链接"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         NavigateUri="https://github.com/XiaochangXu/HeartRateMonitor-composeui"
                                         Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
