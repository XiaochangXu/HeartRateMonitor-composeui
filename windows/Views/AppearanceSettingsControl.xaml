<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.AppearanceSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Appearance_Header"
                   Grid.Row="0"
                   Text="主题和语言"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="20,0,0,12" />

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,12,0">

            <StackPanel Spacing="16">

                <!-- ── 主题模式 ─────────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Appearance_ThemeCard"
                                   Text="主题模式"
                                   FontWeight="SemiBold" />
                        <RadioButtons x:Name="ThemeRadio"
                                      SelectedIndex="{x:Bind ViewModel.ThemeModeIndex, Mode=TwoWay}"
                                      MaxColumns="1">
                            <RadioButton x:Uid="Appearance_ThemeSystem" Content="跟随系统" />
                            <RadioButton x:Uid="Appearance_ThemeLight" Content="亮色主题" />
                            <RadioButton x:Uid="Appearance_ThemeDark" Content="暗色主题" />
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- ── 语言 ───────────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Appearance_LanguageCard"
                                   Text="语言"
                                   FontWeight="SemiBold" />
                        <RadioButtons x:Name="LanguageRadio"
                                      SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                                      MaxColumns="1">
                            <RadioButton x:Uid="Appearance_LangZh" Content="中文" />
                            <RadioButton x:Uid="Appearance_LangEn" Content="英文" />
                        </RadioButtons>
                        <TextBlock x:Uid="Appearance_RestartHint"
                                   Text="切换语言后需要重启应用才能生效。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
