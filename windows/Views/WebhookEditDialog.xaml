<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="HeartRate.Views.WebhookEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Uid="WebhookDialog"
               Title="Webhook"
               PrimaryButtonText="保存"
               CloseButtonText="取消"
               PrimaryButtonClick="OnPrimaryClick"
               DefaultButton="Primary">

    <ScrollViewer Width="460" MaxHeight="460" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,4,0,0">

            <!-- 名称 -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="WebhookDialog_Name" Text="名称" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{x:Bind Editing.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         x:Uid="WebhookDialog_NameBox" PlaceholderText="我的 Webhook" />
            </StackPanel>

            <!-- URL -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="WebhookDialog_Url" Text="URL" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{x:Bind Editing.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         x:Uid="WebhookDialog_UrlBox" PlaceholderText="https://example.com/hook" />
            </StackPanel>

            <!-- 启用 -->
            <ToggleSwitch x:Uid="WebhookDialog_Enabled"
                          Header="启用"
                          IsOn="{x:Bind Editing.Enabled, Mode=TwoWay}" />

            <!-- 触发条件 -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="WebhookDialog_Triggers" Text="触发条件" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CheckBox x:Name="TriggerHeartRate" x:Uid="WebhookDialog_TriggerHr" Content="心率更新" />
                <CheckBox x:Name="TriggerConnected" x:Uid="WebhookDialog_TriggerConn" Content="连接成功" />
                <CheckBox x:Name="TriggerDisconnected" x:Uid="WebhookDialog_TriggerDisc" Content="连接断开" />
            </StackPanel>

            <!-- Body -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="WebhookDialog_Body" Text="请求体" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{x:Bind Editing.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                         FontFamily="Consolas" />
                <TextBlock x:Uid="WebhookDialog_PlaceholderHint" Text="可用占位符：{bpm} {speed}"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Headers -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="WebhookDialog_Headers" Text="请求头" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{x:Bind Editing.Headers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                         FontFamily="Consolas" />
            </StackPanel>

            <!-- 测试 -->
            <StackPanel Spacing="6">
                <Button x:Uid="WebhookDialog_Test" Content="发送测试" Click="OnTestClick" />
                <TextBlock x:Name="TestResultText"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
