<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.FloatWindowSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="620"
             d:DesignHeight="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="FloatSettings_HeaderText"
                   Grid.Row="0"
                   Text="悬浮窗设置"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="20,0,0,12" />

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,12,0">

            <StackPanel Spacing="16">

                <!-- ── 显示选项 ───────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <!-- 显示心形图标 与 开启触摸穿透 同一行 -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Uid="FloatSettings_ShowHeart"
                                          IsOn="{x:Bind ViewModel.Settings.ShowHeart, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          Grid.Column="0" />
                            <ToggleSwitch x:Uid="FloatSettings_ClickThrough"
                                          IsOn="{x:Bind ViewModel.Settings.ClickThroughEnabled, Mode=TwoWay}"
                                          Grid.Column="1" />
                        </Grid>
                        <ToggleSwitch x:Uid="FloatSettings_HeartbeatAnimation"
                                      IsOn="{x:Bind ViewModel.Settings.ShowHeartbeatAnimation, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent="" />
                        <ToggleSwitch x:Uid="FloatSettings_ShowBpm"
                                      IsOn="{x:Bind ViewModel.Settings.ShowBpmText, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent="" />

                        <!-- 锁定热键：与 ToggleSwitch 联动 -->
                        <Grid ColumnSpacing="12" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FloatSettings_HotKeyHeader"
                                       Text="锁定热键"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBox x:Uid="FloatSettings_HotKeyBox"
                                     Text="{x:Bind ViewModel.HotKeyDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     KeyDown="HotKeyTextBox_KeyDown"
                                     Grid.Column="1" />
                            <Button x:Uid="FloatSettings_ClearHotKey"
                                    Content="清除"
                                    Click="ClearHotKey_Click"
                                    Grid.Column="2" />
                        </Grid>
                        <TextBlock x:Uid="FloatSettings_HotKeyHint"
                                   Text="按下热键切换悬浮窗锁定状态。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ── 尺寸 ───────────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FloatSettings_ScaleHeader"
                                       Text="整体大小"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="0.5"
                                    Maximum="2"
                                    StepFrequency="0.05"
                                    Value="{x:Bind ViewModel.Settings.WindowScale, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.ScaleText, Mode=OneWay}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="FloatSettings_HeartSizeHeader"
                                       Text="图标大小"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="12"
                                    Maximum="64"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.Settings.HeartSize, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.HeartSizeText, Mode=OneWay}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 爱心颜色 ───────────────────────────────────────────── -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="FloatSettings_HeartColorHeader"
                                   Text="爱心颜色" />
                        <ColorPicker Color="{x:Bind ViewModel.HeartColor, Mode=TwoWay}"
                                     IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False"
                                     IsHexInputVisible="False"
                                     IsColorSliderVisible="False"
                                     IsColorChannelTextInputVisible="False" />
                    </StackPanel>
                </Border>

                <!-- ── 重置为默认值 ──────────────────────────────────────── -->
                <Button x:Uid="FloatSettings_Reset"
                        Content="重置为默认值"
                        Click="Reset_Click"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
