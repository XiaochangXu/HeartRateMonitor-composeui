<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="HeartRate.Views.HeartRateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 心率详情卡片 ─────────────────────────────────────────────── -->
        <ScrollView Grid.Row="0"
                    Padding="0,0,12,0">

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="20">

                <StackPanel Orientation="Vertical"
                            Spacing="24">

                    <!-- 大号心率数字：爱心 + 数值 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="14">
                        <Viewbox Width="46" Height="46" VerticalAlignment="Center">
                            <Path Fill="{StaticResource HeartBrush}"
                                  Data="M 451.5 808 C 441.8 804.7 433.3 799.3 426 792 L 357 729 C 286.3 664.3 222.5 600.2 165.5 536.5 C 108.5 472.8 80 402.7 80 326 C 80 263.3 101 211 143 169 C 185 127 237.3 106 300 106 C 335.3 106 368.7 113.5 400 128.5 C 431.3 143.5 458 164 480 190 C 502 164 528.7 143.5 560 128.5 C 591.3 113.5 624.7 106 660 106 C 722.7 106 775 127 817 169 C 859 211 880 263.3 880 326 C 880 402.7 851.7 473 795 537 C 738.3 601 674 665.3 602 730 L 534 792 C 526.7 799.3 518.2 804.7 508.5 808 C 498.8 811.3 489.3 813 480 813 C 470.7 813 461.2 811.3 451.5 808 Z" />
                        </Viewbox>
                        <TextBlock Text="{x:Bind ViewModel.HeartRateText, Mode=OneWay}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Uid="HeartRate_Bpm"
                                   Text="bpm"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,10" />
                    </StackPanel>

                    <!-- 状态指示 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <!-- 自动重连时显示圆形进度条，替换状态圆点 -->
                        <ProgressRing IsActive="{x:Bind ViewModel.IsReconnecting, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsReconnecting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center" />
                        <Ellipse Width="8"
                                 Height="8"
                                 Visibility="{x:Bind ViewModel.IsReconnecting, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                 Fill="{x:Bind ViewModel.HasActiveSource, Mode=OneWay, Converter={StaticResource RunningStatusBrushConverter}}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 设备信息表 -->
                    <Grid ColumnSpacing="12"
                          RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="HeartRate_DeviceName"
                                   Text="设备名称"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{x:Bind ViewModel.ConnectedDeviceName, Mode=OneWay}"
                                   FontSize="16"
                                   TextWrapping="WrapWholeWords" />

                        <TextBlock x:Uid="HeartRate_ConnectionMode"
                                   Text="连接方式"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{x:Bind ViewModel.ConnectionModeText, Mode=OneWay}"
                                   FontSize="16" />

                        <TextBlock x:Uid="HeartRate_Address"
                                   Text="地址"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{x:Bind ViewModel.ConnectedAddressText, Mode=OneWay}"
                                   FontSize="16" />

                        <TextBlock x:Uid="HeartRate_HasHrService"
                                   Text="心率服务"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{x:Bind ViewModel.HasHeartRateServiceText, Mode=OneWay}"
                                   FontSize="16" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollView>

        <!-- ── 底部控制栏：连接 + 悬浮窗 ─────────────────────────────────── -->
        <Grid Grid.Row="1"
              Margin="0,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ToggleButton MinWidth="88"
                              Content="{x:Bind ViewModel.ConnectButtonContent, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanToggleConnect, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ToggleConnectCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock x:Uid="HeartRate_FloatLabel"
                           Text="悬浮窗"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsFloatWindowVisible, Mode=OneWay}"
                              Toggled="OnFloatToggleToggled"
                              OnContent=""
                              OffContent=""
                              MinWidth="0"
                              VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
